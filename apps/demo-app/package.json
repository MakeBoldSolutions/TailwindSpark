{
  "name": "@tailwindspark/demo-app",
  "private": true,
  "version": "1.0.0",
  "description": "TailwindSpark Demo Application - Interactive showcase of Tailwind CSS components and design system",
  "type": "module",
  "author": {
    "name": "Mark Hazleton",
    "email": "mark@markhazleton.com",
    "url": "https://markhazleton.com"
  },
  "homepage": "https://makeboldsolutions.github.io/TailwindSpark/",
  "scripts": {
    "dev": "vite",
    "sync:data": "node ../../scripts/sync-projects-data.mjs && node ../../scripts/sync-repos-data.mjs && node ../../scripts/sync-articles-data.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "tsx ../../scripts/generate-meta.ts ../../dist",
    "build:analyze": "tsc -b && vite build --mode analyze && npm run analyze:open",
    "analyze": "npx vite-bundle-analyzer ../../dist --mode gzip",
    "analyze:open": "start ../../reports/bundle-analysis.html",
    "lint": "oxlint -c ../../.oxlintrc.json . --type-aware",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test --config ../../playwright.config.ts",
    "e2e:ui": "playwright test --config ../../playwright.config.ts --ui"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@tailwindspark/design-tokens": "*",
    "@tailwindspark/ui-components": "*",
    "@types/leaflet": "^1.9.22",
    "@types/react-router-dom": "^5.3.3",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-bundle-analyzer": "^1.3.9"
  }
}
