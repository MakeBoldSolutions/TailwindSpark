{
  "name": "@tailwindspark/demo-app",
  "private": true,
  "version": "1.0.0",
  "description": "TailwindSpark Demo Application - Interactive showcase of Tailwind CSS components and design system",
  "type": "module",
  "author": {
    "name": "Mark Hazleton",
    "email": "mark@markhazleton.com",
    "url": "https://markhazleton.com"
  },
  "homepage": "https://markhazleton.github.io/TailwindSpark/",
  "scripts": {
    "dev": "vite",
    "sync:data": "node ../../scripts/sync-projects-data.mjs && node ../../scripts/sync-repos-data.mjs && node ../../scripts/sync-articles-data.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "tsx ../../scripts/generate-meta.ts ../../dist",
    "build:analyze": "tsc -b && vite build --mode analyze && npm run analyze:open",
    "analyze": "npx vite-bundle-analyzer ../../dist --mode gzip",
    "analyze:open": "start ../../reports/bundle-analysis.html",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@tailwindspark/design-tokens": "*",
    "@tailwindspark/ui-components": "*",
    "@types/leaflet": "^1.9.21",
    "@types/react-router-dom": "^5.3.3",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "postcss-cli": "^11.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-bundle-analyzer": "^1.3.8"
  }
}
