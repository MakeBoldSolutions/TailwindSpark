{
  "name": "@tailwindspark/demo-app",
  "private": true,
  "version": "1.0.0",
  "description": "TailwindSpark Demo Application - Interactive showcase of Tailwind CSS components and design system",
  "type": "module",
  "author": {
    "name": "Mark Hazleton",
    "email": "mark@markhazleton.com",
    "url": "https://markhazleton.com"
  },
  "homepage": "https://markhazleton.github.io/TailwindSpark/",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../../scripts/sync-projects-data.mjs",
    "build": "tsc -b && vite build",
    "build:analyze": "npm run build && npm run analyze:open",
    "analyze": "npx vite-bundle-analyzer ../../dist --mode gzip",
    "analyze:open": "start ../../reports/bundle-analysis.html",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@tailwindspark/design-tokens": "*",
    "@tailwindspark/ui-components": "*",
    "@types/leaflet": "^1.9.21",
    "@types/react-router-dom": "^5.3.3",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.32.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vite-bundle-analyzer": "^1.3.6"
  }
}
