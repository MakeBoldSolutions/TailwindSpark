# Security Headers for GitHub Pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https:; connect-src 'self' https://webspark.markhazleton.com https://promptspark.markhazleton.com https://tile.openstreetmap.org https://v2.jokeapi.dev https://api.open-meteo.com; frame-ancestors 'none'

# Cache control for static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# HTML files
/*.html
  Cache-Control: no-cache, no-store, must-revalidate