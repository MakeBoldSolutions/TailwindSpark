{
  "name": "@tailwindspark/ui-components",
  "version": "1.0.0",
  "description": "TailwindSpark UI Components - Reusable React components built with TypeScript and Tailwind CSS",
  "type": "module",
  "author": {
    "name": "Mark Hazleton",
    "email": "mark@markhazleton.com",
    "url": "https://markhazleton.com"
  },
  "homepage": "https://makeboldsolutions.github.io/TailwindSpark/",
  "main": "dist/index.es.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite build --watch",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json src --type-aware",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tailwindspark/design-tokens": "*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^21.0.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
